# Build/data caches and logs
# Includes v2 live scoreboard caches: nba-v2-live, wnba-v2-live, nfl-v2-live,
# cfb-v2-live, cbb-v2-live, soccer-v2-live, plus history/odds scratch dirs.
.build-cache/
data/db_ratings_cache/
docs_old_*/
*.log

# MLB v2 raw history + rebuildable outputs (fetch via scripts/fetch_mlb_history.py,
# rebuild via scripts/build_mlb_training_table.py). Model artifacts in
# data/models/mlb_v2/ ARE tracked; the large OOS prediction dump is not.
data/mlb_history/
data/models/mlb_v2/oos_predictions.csv

# NHL v2 raw history + rebuildable outputs (fetch via scripts/fetch_nhl_history.py,
# rebuild via scripts/build_nhl_training_table.py). Model artifacts in
# data/models/nhl_v2/ ARE tracked; the large OOS prediction dump is not.
data/nhl_history/
data/models/nhl_v2/oos_predictions.csv

# Soccer v2 raw history + rebuildable outputs (fetch via scripts/fetch_soccer_history.py,
# rebuild via scripts/build_soccer_training_table.py). Model artifacts in
# data/models/soccer_v2/ ARE tracked; the large OOS prediction dump is not.
data/soccer_history/
data/models/soccer_v2/oos_predictions.csv

# WNBA v2 raw history + rebuildable outputs (fetch via scripts/fetch_wnba_history.py,
# rebuild via scripts/build_wnba_training_table.py). Model artifacts in
# data/models/wnba_v2/ ARE tracked; the large OOS prediction dump is not.
data/wnba_history/
data/models/wnba_v2/oos_predictions.csv

# NBA v2 raw history + rebuildable outputs (fetch via scripts/fetch_nba_history.py,
# rebuild via scripts/build_nba_training_table.py). Model artifacts in
# data/models/nba_v2/ ARE tracked; the large OOS prediction dump is not.
data/nba_history/
data/models/nba_v2/oos_predictions.csv

# NFL / CFB / CBB v2 rebuildable training tables + OOS dumps.
# Model artifacts in data/models/{nfl,cfb,cbb}_v2/ ARE tracked.
data/nfl_history/
data/cfb_history/
data/cbb_history/
data/models/nfl_v2/oos_predictions.csv
data/models/cfb_v2/oos_predictions.csv
data/models/cbb_v2/oos_predictions.csv

# football-data.co.uk runtime cache (auto-downloaded on demand by
# web/football_data_uk.py)
data/supplemental/football-data-uk/

# Scratch probes
scripts/tmp_probe_*.py

# Scratch / probe scripts (local diagnostics only)
scripts/_diag_*.py
scripts/_probe_*.py
scripts/soccer_probe_out.txt
scripts/wc_sample.json

# NBA ML derived feature matrix (rebuildable from the odds table via
# scripts/train_nba_ml.py); the odds CSV + code are the source of truth.
data/supplemental/nba-ml/feature_matrix.csv
data/supplemental/nba-ml/feature_matrix.parquet

