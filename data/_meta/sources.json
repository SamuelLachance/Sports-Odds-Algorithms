{
  "updated": "2026-07-01",
  "live_slate": {
    "provider": "ESPN public API",
    "note": "Schedules, scores, and market odds for daily picks"
  },
  "supplemental": {
    "clubelo.com": {
      "url": "http://api.clubelo.com",
      "leagues": ["epl", "bundesliga", "laliga", "seriea", "ligue1", "mls"],
      "fields": ["team Elo ratings"],
      "usage": "SharpSoccer live ClubElo layer",
      "cache": "data/supplemental/clubelo/"
    },
    "football-data.co.uk": {
      "leagues": ["epl", "bundesliga", "laliga", "seriea", "ligue1"],
      "fields": ["results", "closing 1X2 odds (B365/Avg)"],
      "usage": "SharpSoccer walk-forward calibration and pick-strategy backtests",
      "cache": "data/supplemental/football-data-uk/"
    },
    "mlb_stats_api": {
      "url": "https://statsapi.mlb.com/api/v1",
      "leagues": ["mlb"],
      "fields": ["season standings", "runs per game", "win%", "probable pitchers"],
      "usage": "SharpBaseball live enrichment + pitcher layer"
    },
    "nhl_web_api": {
      "url": "https://api-web.nhle.com/v1",
      "leagues": ["nhl"],
      "fields": ["team save rate"],
      "usage": "HockeyPoisson goalie xG adjustment"
    },
    "team_data_csv": {
      "leagues": ["nba", "nhl", "mlb"],
      "paths": ["nba/team_data/", "nhl/team_data/", "mlb/team_data/"],
      "usage": "extended history for binary meta tuning and pick backtests only"
    },
    "closing_odds": {
      "nflverse": {
        "url": "https://github.com/nflverse/nfldata",
        "leagues": ["nfl"],
        "fields": ["closing spread", "moneyline", "spread juice"],
        "cache": "data/supplemental/closing-odds/nfl.csv"
      },
      "sbr-online": {
        "url": "https://www.sportsbookreviewsonline.com/scoresoddsarchives/",
        "leagues": ["nba", "nhl", "mlb"],
        "fields": ["closing spread", "moneyline", "spread juice"],
        "cache": "data/supplemental/closing-odds/{league}.csv"
      },
      "sbr-archive": {
        "url": "https://github.com/flancast90/sportsbookreview-scraper",
        "leagues": ["nba", "nhl", "mlb"],
        "fields": ["closing spread", "moneyline"],
        "note": "Fallback JSON archive when SBR HTML pages are empty"
      },
      "football-data.co.uk": {
        "leagues": ["epl", "bundesliga", "laliga", "seriea", "ligue1"],
        "fields": ["closing 1X2 odds"],
        "usage": "soccer walk-forward backtests via closing_odds_db"
      },
      "usage": "Real closing lines for pick-strategy backtests and CLV grading; falls back to simulated markets when missing"
    }
  }
}
